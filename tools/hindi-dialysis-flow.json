{
  "description": "Hindi dialysis referral keypad confirmation for one team-owned test destination",
  "initial_state": "Trigger",
  "flags": { "allow_concurrent_calls": false },
  "states": [
    {
      "name": "Trigger",
      "type": "trigger",
      "transitions": [
        { "event": "incomingMessage" },
        { "event": "incomingCall" },
        { "event": "incomingRequest", "next": "call_test_phone" }
      ],
      "properties": { "offset": { "x": 0, "y": 0 } }
    },
    {
      "name": "call_test_phone",
      "type": "make-outgoing-call-v2",
      "transitions": [
        { "event": "answered", "next": "dialysis_reply" },
        { "event": "busy" },
        { "event": "noAnswer" },
        { "event": "failed" }
      ],
      "properties": {
        "from": "{{flow.channel.address}}", "to": "{{contact.channel.address}}",
        "timeout": 25, "record": false, "offset": { "x": 0, "y": 190 }
      }
    },
    {
      "name": "dialysis_reply",
      "type": "gather-input-on-call",
      "transitions": [
        { "event": "keypress", "next": "save_reply" },
        { "event": "speech" },
        { "event": "timeout" }
      ],
      "properties": {
        "say": "क्या यह अस्पताल आज डायलिसिस के लिए रेफ़र किए गए मरीज़ को स्वीकार कर सकता है? हाँ के लिए एक दबाएँ, नहीं के लिए दो दबाएँ।",
        "language": "hi-IN", "voice": "Polly.Aditi", "number_of_digits": 1,
        "stop_gather": true, "timeout": 8, "loop": 1, "offset": { "x": 0, "y": 380 }
      }
    },
    {
      "name": "save_reply",
      "type": "set-variables",
      "transitions": [{ "event": "next" }],
      "properties": {
        "variables": [{ "index": "0", "key": "dialysis_answer", "value": "{{widgets.dialysis_reply.Digits}}" }],
        "offset": { "x": 0, "y": 560 }
      }
    }
  ]
}
